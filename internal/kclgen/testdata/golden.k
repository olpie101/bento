# Code generated by bento list --format kcl. DO NOT EDIT.
# Generated from bento golden, built test.
# See https://warpstreamlabs.github.io/bento/docs/configuration/using_kcl for usage.

schema LabelMixin:
    r"""An optional label for the component, used when referencing it from other parts of the config."""
    label?: str

schema ProcessorsMixin:
    r"""An optional list of processors executed on each message after the component processes it."""
    processors?: [Processor]

schema Config:
    # The input.
    input?: Input
    # The output.
    output?: Output

schema GenerateInput:
    r"""Generate messages."""
    # A bloblang mapping.
    mapping: str
    # Interval between messages.
    interval?: str = "1s"
    # Number of messages to generate.
    count?: int = 0
    # An optional check expression.
    $check?: str
    # TLS configuration.
    tls?: Tls

schema HttpClientInput:
    r"""Consume messages from an HTTP endpoint."""
    # The endpoint URL.
    url: str
    # [SECRET] API token.
    token?: str = ""
    # [DEPRECATED] Use url instead.
    @deprecated(reason="Use url instead.", strict=False)
    legacy?: str = ""
    # TLS configuration.
    tls?: Tls

schema Tls:
    r"""TLS configuration."""
    # Whether TLS is enabled.
    enabled?: bool = False
    # PEM root CAs.
    root_cas?: str = ""

schema Input:
    mixin [LabelMixin, ProcessorsMixin]
    # Generate messages.
    generate?: GenerateInput
    # Consume messages from an HTTP endpoint.
    http_client?: HttpClientInput

    check:
        len([x for x in [generate, http_client] if x != Undefined]) == 1, "exactly one input variant must be set"

schema StdoutOutput:
    r"""Write to stdout."""
    # Output codec.
    codec?: str = "lines"

schema Output:
    mixin [LabelMixin, ProcessorsMixin]
    # Write to stdout.
    stdout?: StdoutOutput

    check:
        len([x for x in [stdout] if x != Undefined]) == 1, "exactly one output variant must be set"

schema SwitchProcessorCase:
    r"""Conditionally routes messages to processors."""
    # A Bloblang check expression.
    $check?: str
    # Processors to apply when the case matches.
    processors?: [Processor]

schema Processor:
    mixin [LabelMixin]
    # Executes a Bloblang mapping.
    mapping?: str
    # Conditionally routes messages to processors.
    switch?: [SwitchProcessorCase]
    # Executes a list of child processors.
    try?: [Processor]

    check:
        len([x for x in [mapping, switch, try] if x != Undefined]) == 1, "exactly one processor variant must be set"

schema Cache:
    mixin [LabelMixin]

schema RateLimit:
    mixin [LabelMixin]

schema Buffer:
    _empty?: any = Undefined

schema Metric:
    _empty?: any = Undefined

schema Tracer:
    _empty?: any = Undefined

schema Scanner:
    _empty?: any = Undefined

protocol ProcessorProtocol:
    r"""Structural contract for Bento processor components."""
    label?: str

protocol InputProtocol:
    r"""Structural contract for Bento input components."""
    label?: str
    processors?: [ProcessorProtocol]

protocol OutputProtocol:
    r"""Structural contract for Bento output components."""
    label?: str
    processors?: [ProcessorProtocol]

protocol CacheProtocol:
    r"""Structural contract for Bento cache components."""
    label?: str

protocol RateLimitProtocol:
    r"""Structural contract for Bento rate-limit components."""
    label?: str

protocol ScannerProtocol:
